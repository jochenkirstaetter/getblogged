            <button type="button" class="media-lightbox-close" aria-label="Close preview">&times;</button>
            <div class="media-lightbox-body"></div>
        </div>
    </dialog>

    <script>
    (function() {
        var docfxLoaded = false;
        function loadDocfxScript() {
            if (docfxLoaded) return;
            docfxLoaded = true;
            var s = document.createElement('script');
            s.type = 'module';
            s.src = '{{_rel}}public/docfx.min.js';
            document.body.appendChild(s);
        }
        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll', 'focusin'];
        function onUserInteraction() {
            events.forEach(function(evt) {
                window.removeEventListener(evt, onUserInteraction, { passive: true, capture: true });
            });
            loadDocfxScript();
        }
        events.forEach(function(evt) {
            window.addEventListener(evt, onUserInteraction, { passive: true, capture: true });
        });
        setTimeout(loadDocfxScript, 8000);
    })();
    </script>
