      {{#_googleAnalyticsTagId}}
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{_googleAnalyticsTagId}}');
        function loadGA() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id={{_googleAnalyticsTagId}}';
          document.head.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGA, { timeout: 2000 });
        } else {
          window.addEventListener('load', loadGA);
        }
      </script>
      {{/_googleAnalyticsTagId}}

      {{#_googleAdSenseClientId}}
      <script>
        (function() {
          if (typeof window === 'undefined' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') return;
          var adLoaded = false;
          function loadAdSense() {
            if (adLoaded) return;
            adLoaded = true;
            var events = ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'];
            events.forEach(function(evt) {
              window.removeEventListener(evt, loadAdSense, { passive: true, capture: true });
            });
            var adScript = document.createElement('script');
            adScript.setAttribute('data-ad-client', '{{_googleAdSenseClientId}}');
            adScript.async = true;
            adScript.crossOrigin = 'anonymous';
            adScript.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js';
            document.head.appendChild(adScript);
          }
          var events = ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'];
          events.forEach(function(evt) {
            window.addEventListener(evt, loadAdSense, { passive: true, capture: true });
          });
          setTimeout(loadAdSense, 8000);
        })();
      </script>
      {{/_googleAdSenseClientId}}

