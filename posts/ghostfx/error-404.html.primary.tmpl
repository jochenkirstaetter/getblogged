{{!
This error template is used for all 404 errors, which might occur on your site.
It's a good idea to keep this template as minimal as possible in terms of both file size and complexity.
}}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{{title}}</title>
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" type="text/css" href="{{_rel}}public/built/screen.css{{#_assetVersion}}?v={{.}}{{/_assetVersion}}" />
    <link rel="stylesheet" href="{{_rel}}public/main.css{{#_assetVersion}}?v={{.}}{{/_assetVersion}}">
    <link rel="stylesheet" href="{{_rel}}public/ghostfx.css{{#_assetVersion}}?v={{.}}{{/_assetVersion}}">
</head>
<body class="error-template">
    <div class="site-wrapper">

        <header class="site-header outer {{#image}}" style="background-image: url({{image}}){{else}}no-cover{{/image}}">
            <div class="inner">
                <nav class="site-nav-center">
                    {{#@blog.logo}}
                        <a class="site-nav-logo" href="{{#_appUrl}}{{_appUrl}}{{/_appUrl}}{{^_appUrl}}{{_rel}}{{/_appUrl}}"><img src="{{_rel}}{{@blog.logo}}" alt="{{_appTitle}}" /></a>
                    {{else}}
                        <a class="site-nav-logo" href="{{#_appUrl}}{{_appUrl}}{{/_appUrl}}{{^_appUrl}}{{_rel}}{{/_appUrl}}">{{_appTitle}}</a>
                    {{/@blog.logo}}
                </nav>
            </div>
        </header>

        <main id="site-main" class="site-main outer">
            <div class="inner">

                <section class="error-message">
                    <h1 class="error-code">{{statusCode}}</h1>
                    <p class="error-description">{{message}}</p>
                    <a class="error-link" href="{{#_appUrl}}{{_appUrl}}{{/_appUrl}}{{^_appUrl}}{{_rel}}{{/_appUrl}}">Go to the front page →</a>
                </section>
            </div>
        </main>

        
        <aside class="outer">
            <div class="inner">
                <div class="post-feed">
{{{conceptual}}}
                    {{#posts}}
                        {{>partials/post-card}}
                    {{/posts}}
                </div>
            </div>
        </aside>
        

    </div>
</body>
</html>
