{{#_galleryFlexible}}
<script>
(function() {
    function layoutFlexibleGalleries() {
        var galleries = document.querySelectorAll('.gallery, .GALLERY, .alert-gallery');
        galleries.forEach(function(gallery) {
            gallery.classList.add('is-flexible');
            var images = gallery.querySelectorAll('img');
            images.forEach(function(img) {
                var target = img.closest('a') || img;
                function applyRatio() {
                    var w = img.naturalWidth || img.width || 4;
                    var h = img.naturalHeight || img.height || 3;
                    var ratio = (w / h).toFixed(4);
                    target.style.setProperty('flex', ratio + ' 1 0%', 'important');
                    target.style.setProperty('min-width', 'min(100%, 180px)', 'important');
                    target.style.setProperty('aspect-ratio', ratio + ' / 1', 'important');
                }
                if (img.complete && img.naturalWidth > 0) {
                    applyRatio();
                } else {
                    img.addEventListener('load', applyRatio, { once: true });
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', layoutFlexibleGalleries);
    } else {
        layoutFlexibleGalleries();
    }
})();
</script>
{{/_galleryFlexible}}
