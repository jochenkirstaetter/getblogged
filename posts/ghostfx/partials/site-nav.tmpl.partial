<nav class="site-nav">
    <div class="site-nav-left">
        <button class="site-nav-hamburger" aria-label="Toggle menu" onclick="toggleMobileNav();return false;"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/></svg></button>
        {{^isHome}}
            {{#_appLogoPath}}
                <a class="site-nav-logo" href="{{#_appUrl}}{{_appUrl}}{{/_appUrl}}{{^_appUrl}}{{_rel}}{{/_appUrl}}"><img src="{{_rel}}{{_appLogoPath}}" alt="{{_appTitle}}" /></a>
            {{/_appLogoPath}}
            {{^_appLogoPath}}
                <a class="site-nav-logo" href="{{#_appUrl}}{{_appUrl}}{{/_appUrl}}{{^_appUrl}}{{_rel}}{{/_appUrl}}">{{_appTitle}}</a>
            {{/_appLogoPath}}
        {{/isHome}}
        <ul class="nav site-nav-menu" role="menu">
            <li class="nav-about" role="menuitem"><a href="{{_rel}}about.html">About</a></li>
            <li class="nav-blog" role="menuitem"><a href="{{_rel}}blog.html">Blog</a></li>
            <li class="nav-community" role="menuitem"><a href="{{_rel}}community.html">Community</a></li>
            <li class="nav-speaking" role="menuitem"><a href="{{_rel}}speaking.html">Speaking</a></li>
        </ul>
    </div>
    {{#_enableSearch}}
    <div class="site-nav-center">
        <button type="button" class="site-nav-search-btn" onclick="window.openSearchPalette && window.openSearchPalette();return false;" title="{{#_searchHotkey}}Search posts ({{.}}){{/_searchHotkey}}{{^_searchHotkey}}{{#__global.searchTitle}}{{.}}{{/__global.searchTitle}}{{^__global.searchTitle}}Search posts (Ctrl+K){{/__global.searchTitle}}{{/_searchHotkey}}" aria-label="{{#_searchHotkey}}Search posts ({{.}}){{/_searchHotkey}}{{^_searchHotkey}}{{#__global.searchAriaLabel}}{{.}}{{/__global.searchAriaLabel}}{{^__global.searchAriaLabel}}Search posts (Ctrl+K){{/__global.searchAriaLabel}}{{/_searchHotkey}}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="search-btn-placeholder">Search posts...</span>
        </button>
        <button type="button" class="site-nav-voice-btn" title="{{#_voiceHotkey}}Search with voice ({{.}}){{/_voiceHotkey}}{{^_voiceHotkey}}{{#__global.searchVoiceTitle}}{{.}}{{/__global.searchVoiceTitle}}{{^__global.searchVoiceTitle}}Search with voice (Ctrl+M){{/__global.searchVoiceTitle}}{{/_voiceHotkey}}" aria-label="{{#_voiceHotkey}}Search by voice ({{.}}){{/_voiceHotkey}}{{^_voiceHotkey}}{{#__global.searchVoiceAriaLabel}}{{.}}{{/__global.searchVoiceAriaLabel}}{{^__global.searchVoiceAriaLabel}}Search by voice (Ctrl+M){{/__global.searchVoiceAriaLabel}}{{/_voiceHotkey}}" onclick="window.openSearchPalette && window.openSearchPalette({ autoStartVoice: true }); return false;">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" y1="19" x2="12" y2="23"/>
                <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
        </button>
    </div>
    {{/_enableSearch}}
    <div class="site-nav-right">
        <div class="social-links">
            <a class="social-link social-link-github" href="https://github.com/jochenkirstaetter/ghostfx" title="GitHub" target="_blank" rel="noreferrer noopener">{{>partials/icons/github}}</a>
            <a class="social-link social-link-twitter" href="https://x.com/jkirstaetter" title="Twitter / X" target="_blank" rel="noreferrer noopener">{{>partials/icons/x}}</a>
            <a class="social-link social-link-facebook" href="https://facebook.com/jochen.kirstaetter" title="Facebook" target="_blank" rel="noreferrer noopener">{{>partials/icons/facebook}}</a>
        </div>
        {{#_appUrl}}
        <a class="rss-button" href="https://feedly.com/i/subscription/feed/{{_appUrl}}/rss/" title="RSS" target="_blank" rel="noreferrer noopener"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg></a>
        {{/_appUrl}}
        <div class="dropdown theme-dropdown" style="display: inline-block; margin-left: 10px;">
            <button type="button" title="Change theme" aria-label="Change theme" class="btn border-0 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" style="color: #fff; text-decoration: none; padding: 0 5px; background: transparent; cursor: pointer;">
                <i class="bi bi-circle-half" style="font-size: 1.6rem;"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="#" onclick="setTheme('light');return false;"><i class="bi bi-sun"></i> Light</a></li>
                <li><a class="dropdown-item" href="#" onclick="setTheme('dark');return false;"><i class="bi bi-moon"></i> Dark</a></li>
                <li><a class="dropdown-item" href="#" onclick="setTheme('auto');return false;"><i class="bi bi-circle-half"></i> Auto</a></li>
            </ul>
        </div>
        <script>
          window.toggleMobileNav = function() {
            var menu = document.querySelector('.site-nav-menu');
            if (menu) { menu.classList.toggle('mobile-menu-active'); }
          };
          document.addEventListener('click', function(e) {
            var menu = document.querySelector('.site-nav-menu');
            var btn = document.querySelector('.site-nav-hamburger');
            if (menu && menu.classList.contains('mobile-menu-active') && !menu.contains(e.target) && (!btn || !btn.contains(e.target))) {
              menu.classList.remove('mobile-menu-active');
            }
          });
          function setTheme(t) {
            try { localStorage.setItem('theme', t); } catch (e) {}
            var isDark = t === 'dark' || (t === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
            var icon = document.querySelector('.dropdown-toggle i.bi');
            if (icon) { icon.className = 'bi ' + (t === 'light' ? 'bi-sun' : t === 'dark' ? 'bi-moon' : 'bi-circle-half'); }
          }
          (function() {
            var t = 'auto';
            try { t = localStorage.getItem('theme') || 'auto'; } catch (e) {}
            var isDark = t === 'dark' || (t === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
            var icon = document.querySelector('.dropdown-toggle i.bi');
            if (icon) { icon.className = 'bi ' + (t === 'light' ? 'bi-sun' : t === 'dark' ? 'bi-moon' : 'bi-circle-half'); }

            // Live OS color scheme listener for Auto mode
            if (window.matchMedia) {
              var mq = window.matchMedia('(prefers-color-scheme: dark)');
              var onSchemeChange = function(e) {
                var current = 'auto';
                try { current = localStorage.getItem('theme') || 'auto'; } catch (err) {}
                if (current === 'auto') {
                  document.documentElement.setAttribute('data-bs-theme', e.matches ? 'dark' : 'light');
                }
              };
              if (mq.addEventListener) {
                mq.addEventListener('change', onSchemeChange);
              } else if (mq.addListener) {
                mq.addListener(onSchemeChange);
              }
            }
            // WebMCP Tool Registration for AI Assistants
            if (typeof document !== 'undefined' && 'modelContext' in document && document.modelContext && document.modelContext.registerTool) {
              try {
                document.modelContext.registerTool({
                  name: 'search_blog',
                  description: 'Search articles and blog posts by keywords',
                  inputSchema: {
                    type: 'object',
                    properties: {
                      query: { type: 'string', description: 'Search term or keyword' }
                    },
                    required: ['query']
                  },
                  execute: function(args) {
                    var q = args && args.query ? args.query : '';
                    if (window.openSearchPalette) {
                      window.openSearchPalette();
                      var input = document.getElementById('search-palette-input');
                      if (input) {
                        input.value = q;
                        input.dispatchEvent(new Event('input', { bubbles: true }));
                      }
                    }
                    return Promise.resolve({ content: [{ type: 'text', text: 'Search executed for: ' + q }] });
                  },
                  annotations: { readOnlyHint: true }
                });
              } catch (e) {}
            }
          })();
        </script>
    </div>
</nav>
