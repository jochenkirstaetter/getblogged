<script>
(function() {
    function registerVfpLanguage(hljs) {
        if (!hljs || typeof hljs.registerLanguage !== 'function') return;
        if (hljs.getLanguage('foxpro') || hljs.getLanguage('vfp')) return;

        hljs.registerLanguage('foxpro', function(hljs) {
            var KEYWORDS = {
                // Core language statements and control flow
                keyword:
                    'procedure endproc function endfunc lparameters parameters local dimension hidden protected public ' +
                    'return with endwith if else endif iif do while enddo for to step endfor next scan while for endscan ' +
                    'do case case otherwise endcase try catch finally endtry createobject newobject addobject removeobject ' +
                    'declare in set text endtext define class as enddefine default nodefault dodef dts dtl dtd ' +
                    'select from where group by having order by into cursor table union all insert into values update delete ' +
                    'use append blank replace delete recall count sum average calculate seek locate continue skip ' +
                    'scatter gather name memo memoedit clear read events readkey quit release cancel retry resume ' +
                    'on error on key on shutdown assert note this thisform thisformset parent keyboard dodefault',

                // Boolean and null literals
                literal:
                    '.t. .f. .null. null true false',

                // VFP Data types (used in Cast, Create Table, or COM declarations)
                type:
                    'character string integer int numeric float double currency logical date datetime memo blob general variant',

                // Built-in VFP functions and API helpers
                built_in:
                    'alltrim lower upper evl nvl str val int cast padr padl padc transform substr left right at rat occurs ' +
                    'between inlist chr asc sys file directory adir afields alines alen fcount reccount recno bittest ' +
                    'bitor bitand bitxor objtoclient message messagebox addbs forceext forcepath justpath justfname ' +
                    'juststem justext getenv mcol mrow mdown pemstatus bindevent unbindevent eventhandler sqlexec ' +
                    'sqlconnect sqldisconnect sqlcommit sqlrollback sqlsetprop sqlgetprop date time datetime year month ' +
                    'day hour minute sec empty type vartype evaluate execscript',

                // System & environment variables
                'variable.language':
                    '_screen _vfp _samples _foxcode _codesense _genmenu _genxtab ' +
                    '_builder _spellcheck _include _startup'
            };

            var VFP_LINE_COMMENT = {
                className: 'comment',
                begin: '^\\s*(\\*|NOTE\\b)',
                end: '$',
                relevance: 10
            };

            var VFP_INLINE_COMMENT = {
                className: 'comment',
                begin: '&&',
                end: '$',
                relevance: 5
            };

            var VFP_PREPROCESSOR = {
                className: 'meta',
                begin: '^\\s*#(define|include|if|else|endif|ifdef|ifndef|undef|region|endregion)\\b',
                end: '$'
            };

            return {
                name: 'Visual FoxPro',
                aliases: ['vfp', 'foxpro', 'visualfoxpro', 'xbase'],
                case_insensitive: true,
                keywords: KEYWORDS,
                contains: [
                    VFP_PREPROCESSOR,
                    VFP_LINE_COMMENT,
                    VFP_INLINE_COMMENT,
                    hljs.APOS_STRING_MODE,
                    hljs.QUOTE_STRING_MODE,
                    {
                        className: 'number',
                        variants: [
                            { begin: '\\b0x[0-9a-fA-F]+\\b' },
                            { begin: '\\b\\d+(\\.\\d+)?\\b' }
                        ],
                        relevance: 0
                    }
                ]
            };
        });

        // Register alias for vfp
        var vfpDef = hljs.getLanguage('foxpro');
        if (vfpDef && !hljs.getLanguage('vfp')) {
            hljs.registerLanguage('vfp', function() { return vfpDef; });
        }
    }

    window.registerVfpLanguage = registerVfpLanguage;
})();
</script>
