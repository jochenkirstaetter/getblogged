    "name": "{{#title}}{{title}}{{/title}}",
    "headline": "{{#title}}{{title}}{{/title}}",
    "url": "{{#canonicalUrl}}{{canonicalUrl}}{{/canonicalUrl}}{{^canonicalUrl}}{{#_appUrl}}{{_appUrl}}/{{#uid}}{{uid}}{{/uid}}{{^uid}}{{slug}}{{/uid}}.html{{/_appUrl}}{{/canonicalUrl}}",
    "description": "{{#metaDescription}}{{metaDescription}}{{/metaDescription}}{{^metaDescription}}{{#description}}{{description}}{{/description}}{{/metaDescription}}",
