        "url": "{{#_appUrl}}{{_appUrl}}/{{/_appUrl}}",
        "logo": {
            "@type": "ImageObject",
            "url": "{{#_appUrl}}{{#_appLogoPath}}{{_appUrl}}/{{_appLogoPath}}{{/_appLogoPath}}{{^_appLogoPath}}{{_appUrl}}/favicon.png{{/_appLogoPath}}{{/_appUrl}}{{^_appUrl}}favicon.png{{/_appUrl}}",
            "width": 60,
