{{! Everything inside the #author tags pulls data from the author }}
{{#primary_author}}

<section class="author-card">
    {{#profile_image}}
        <img class="author-profile-image" src="{{_rel}}{{profile_image}}" alt="{{title}}" />
    {{else}}
        <span class="avatar-wrapper">{{>partials/icons/avatar}}</span>
    {{/profile_image}}
    <section class="author-card-content">
        <h4 class="author-card-name"><a href="{{_rel}}{{#uid}}{{uid}}{{/uid}}{{^uid}}{{slug}}{{/uid}}.html">{{title}}</a></h4>
        {{#bio}}
            <p>{{bio}}</p>
        {{else}}
            <p>Read <a href="{{_rel}}{{#uid}}{{uid}}{{/uid}}{{^uid}}{{slug}}{{/uid}}.html">more posts</a> by this author.</p>
        {{/bio}}
    </section>
</section>
<div class="post-full-footer-right">
    <a class="author-card-button" href="{{_rel}}{{#uid}}{{uid}}{{/uid}}{{^uid}}{{slug}}{{/uid}}.html">Read More</a>
</div>

{{/primary_author}}
