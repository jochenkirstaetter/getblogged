{{#_enableSearch}}
<dialog id="search-palette-modal" class="media-lightbox search-palette-dialog" closedby="any" aria-label="Search Blog">
    <div class="media-lightbox-content search-palette-content">
        <div class="search-palette-container">
            <div class="search-palette-header">
                <div class="search-palette-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>
                <input
                    id="search-palette-input"
                    type="search"
                    class="search-palette-input"
                    placeholder="Search posts, topics, keywords..."
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    spellcheck="false"
                    aria-label="Search query"
                    aria-autocomplete="list"
                    aria-controls="search-palette-results"
                />
                <button type="button" id="search-palette-clear" class="search-palette-action-btn search-palette-clear" aria-label="{{#__global.searchClearAriaLabel}}{{.}}{{/__global.searchClearAriaLabel}}{{^__global.searchClearAriaLabel}}Clear search query{{/__global.searchClearAriaLabel}}" title="{{#__global.searchClearTitle}}{{.}}{{/__global.searchClearTitle}}{{^__global.searchClearTitle}}Clear search query{{/__global.searchClearTitle}}" style="display: none;">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"></path>
                        <path d="M22 21H7"></path>
                        <path d="m5 11 9 9"></path>
                    </svg>
                </button>
                <button type="button" id="search-palette-voice" class="search-palette-action-btn search-palette-voice" aria-label="{{#_voiceHotkey}}Search by voice ({{.}}){{/_voiceHotkey}}{{^_voiceHotkey}}{{#__global.searchVoiceAriaLabel}}{{.}}{{/__global.searchVoiceAriaLabel}}{{^__global.searchVoiceAriaLabel}}Search by voice (Ctrl+M){{/__global.searchVoiceAriaLabel}}{{/_voiceHotkey}}" title="{{#_voiceHotkey}}Search with voice ({{.}}){{/_voiceHotkey}}{{^_voiceHotkey}}{{#__global.searchVoiceTitle}}{{.}}{{/__global.searchVoiceTitle}}{{^__global.searchVoiceTitle}}Search with voice (Ctrl+M){{/__global.searchVoiceTitle}}{{/_voiceHotkey}}">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                        <line x1="12" y1="19" x2="12" y2="23"/>
                        <line x1="8" y1="23" x2="16" y2="23"/>
                    </svg>
                </button>
                <button type="button" class="search-palette-action-btn search-palette-close-btn search-palette-close" aria-label="{{#__global.searchCloseAriaLabel}}{{.}}{{/__global.searchCloseAriaLabel}}{{^__global.searchCloseAriaLabel}}Close search (Esc){{/__global.searchCloseAriaLabel}}" title="{{#__global.searchCloseTitle}}{{.}}{{/__global.searchCloseTitle}}{{^__global.searchCloseTitle}}Close search (Esc){{/__global.searchCloseTitle}}">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div id="search-palette-body" class="search-palette-body">
                <div id="search-palette-initial" class="search-palette-initial">
                    <div class="search-palette-section-title">Quick Actions</div>
                    <div class="search-palette-quick-actions">
                        <a href="{{_rel}}blog.html" class="search-palette-quick-item">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                            <span>Browse All Blog Posts</span>
                        </a>
                        <a href="{{_rel}}tags.html" class="search-palette-quick-item">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                            <span>Explore Tags & Categories</span>
                        </a>
                        <a href="{{_rel}}about.html" class="search-palette-quick-item">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            <span>About JoKi</span>
                        </a>
                    </div>
                </div>

                <div id="search-palette-results" class="search-palette-results" role="listbox" style="display: none;"></div>
                <div id="search-palette-empty" class="search-palette-empty" style="display: none;">
                    <div class="search-palette-empty-icon">🔍</div>
                    <div class="search-palette-empty-title">No matching posts found</div>
                    <div class="search-palette-empty-text">Try searching for different keywords or topics.</div>
                </div>
                <div id="search-palette-loading" class="search-palette-loading" style="display: none;">
                    <div class="search-palette-spinner"></div>
                    <span>Searching index...</span>
                </div>
            </div>

            <div class="search-palette-footer">
                <div class="search-palette-footer-shortcuts">
                    <span class="shortcut-item" title="{{#__global.searchShortcutNavigate}}{{.}}{{/__global.searchShortcutNavigate}}{{^__global.searchShortcutNavigate}}Navigate results (Up/Down Arrows){{/__global.searchShortcutNavigate}}" aria-label="{{#__global.searchShortcutNavigate}}{{.}}{{/__global.searchShortcutNavigate}}{{^__global.searchShortcutNavigate}}Navigate results (Up/Down Arrows){{/__global.searchShortcutNavigate}}">
                        <kbd>↑</kbd><kbd>↓</kbd>
                        <span>navigate</span>
                    </span>
                    <span class="shortcut-item" title="{{#__global.searchShortcutSelect}}{{.}}{{/__global.searchShortcutSelect}}{{^__global.searchShortcutSelect}}Open selected article (Enter){{/__global.searchShortcutSelect}}" aria-label="{{#__global.searchShortcutSelect}}{{.}}{{/__global.searchShortcutSelect}}{{^__global.searchShortcutSelect}}Open selected article (Enter){{/__global.searchShortcutSelect}}">
                        <kbd>↵</kbd>
                        <span>select</span>
                    </span>
                    <span class="shortcut-item" title="{{#__global.searchShortcutClose}}{{.}}{{/__global.searchShortcutClose}}{{^__global.searchShortcutClose}}Close search palette (Escape){{/__global.searchShortcutClose}}" aria-label="{{#__global.searchShortcutClose}}{{.}}{{/__global.searchShortcutClose}}{{^__global.searchShortcutClose}}Close search palette (Escape){{/__global.searchShortcutClose}}">
                        <kbd>ESC</kbd>
                        <span>close</span>
                    </span>
                </div>
                <div id="search-palette-stats" class="search-palette-stats" aria-live="polite"></div>
            </div>
        </div>
    </div>
</dialog>

<script>
(function () {
    var configuredHotkey = '{{#_searchHotkey}}{{{.}}}{{/_searchHotkey}}{{^_searchHotkey}}{{#__global.searchHotkey}}{{{.}}}{{/__global.searchHotkey}}{{^__global.searchHotkey}}Ctrl+K{{/__global.searchHotkey}}{{/_searchHotkey}}'.trim();
    var configuredVoiceHotkey = '{{#_voiceHotkey}}{{{.}}}{{/_voiceHotkey}}{{^_voiceHotkey}}{{#__global.searchVoiceHotkey}}{{{.}}}{{/__global.searchVoiceHotkey}}{{^__global.searchVoiceHotkey}}Ctrl+M{{/__global.searchVoiceHotkey}}{{/_voiceHotkey}}'.trim();
    var voiceListeningText = '{{#__global.searchVoiceListening}}{{{.}}}{{/__global.searchVoiceListening}}{{^__global.searchVoiceListening}}Listening... Speak now{{/__global.searchVoiceListening}}';
    var isMac = typeof navigator !== 'undefined' && (/Mac|iPod|iPhone|iPad/.test(navigator.platform) || /Macintosh|Mac OS X/.test(navigator.userAgent));

    // Update search button title and aria-label on Mac to show ⌘K
    if (isMac) {
        if (configuredHotkey.toLowerCase().indexOf('ctrl') !== -1) {
            var searchButtons = document.querySelectorAll('.site-nav-search-btn, .floating-header-search-btn');
            searchButtons.forEach(function (btn) {
                var t = btn.getAttribute('title');
                if (t) btn.setAttribute('title', t.replace(/ctrl\+k/i, '⌘K').replace(/ctrl/i, '⌘'));
                var a = btn.getAttribute('aria-label');
                if (a) btn.setAttribute('aria-label', a.replace(/ctrl\+k/i, '⌘K').replace(/ctrl/i, '⌘'));
            });
        }
        // Update voice button title and aria-label on Mac to show ⌘M
        if (configuredVoiceHotkey.toLowerCase().indexOf('ctrl') !== -1) {
            var voiceButtons = document.querySelectorAll('#search-palette-voice, .site-nav-voice-btn');
            voiceButtons.forEach(function (btn) {
                var t = btn.getAttribute('title');
                if (t) btn.setAttribute('title', t.replace(/ctrl\+m/i, '⌘M').replace(/ctrl/i, '⌘'));
                var a = btn.getAttribute('aria-label');
                if (a) btn.setAttribute('aria-label', a.replace(/ctrl\+m/i, '⌘M').replace(/ctrl/i, '⌘'));
            });
        }
    }

    var modal = document.getElementById('search-palette-modal');
    if (!modal) return;

    var input = document.getElementById('search-palette-input');
    var clearBtn = document.getElementById('search-palette-clear');
    var voiceBtn = document.getElementById('search-palette-voice');
    var navVoiceBtns = document.querySelectorAll('.site-nav-voice-btn');
    var closeBtn = modal.querySelector('.search-palette-close');
    var resultsContainer = document.getElementById('search-palette-results');
    var initialContainer = document.getElementById('search-palette-initial');
    var emptyContainer = document.getElementById('search-palette-empty');
    var loadingContainer = document.getElementById('search-palette-loading');
    var statsContainer = document.getElementById('search-palette-stats');

    var SpeechRecognition = typeof window !== 'undefined' ? (window.SpeechRecognition || window.webkitSpeechRecognition) : null;
    var recognition = null;
    var isListening = false;

    var searchIndex = null;
    var searchData = [];
    var isLoadingIndex = false;
    var selectedIndex = -1;
    var currentResults = [];

    // Helper: Clean raw summary string from DocFX
    function cleanSummary(raw) {
        if (!raw) return '';
        var s = raw;
        // Strip Disqus, Google AdSense and script noise from summary
        s = s.replace(/if\s*\(\s*typeof\s*window\s*!==\s*'undefined'[\s\S]*$/, '');
        s = s.replace(/\(function\(\)\s*\{\s*var\s*loaded\s*=\s*false[\s\S]*$/, '');
        s = s.replace(/\(window\.adsbygoogle[\s\S]*$/, '');
        s = s.replace(/<[^>]*>/g, ' ');
        return s.replace(/\s+/g, ' ').trim();
    }

    // Load search index json
    function loadSearchIndex(callback) {
        if (searchIndex) {
            if (callback) callback();
            return;
        }
        if (isLoadingIndex) return;
        isLoadingIndex = true;
        if (loadingContainer) loadingContainer.style.display = 'flex';

        var rel = '{{_rel}}';
        fetch(rel + 'index.json{{#_assetVersion}}?v={{.}}{{/_assetVersion}}')
            .then(function (res) {
                if (!res.ok) throw new Error('Index HTTP error: ' + res.status);
                return res.json();
            })
            .then(function (data) {
                searchIndex = data;
                searchData = [];
                for (var key in data) {
                    if (Object.prototype.hasOwnProperty.call(data, key)) {
                        var item = data[key];
                        var title = (item.title || key).replace(/\s*-\s*Get Blogged by JoKi\s*$/i, '');
                        var summary = cleanSummary(item.summary);
                        var href = item.href || key;
                        searchData.push({
                            href: rel + href,
                            rawHref: href,
                            title: title,
                            summary: summary
                        });
                    }
                }
                isLoadingIndex = false;
                if (loadingContainer) loadingContainer.style.display = 'none';
                if (callback) callback();
            })
            .catch(function (err) {
                console.error('Failed to load search index:', err);
                isLoadingIndex = false;
                if (loadingContainer) loadingContainer.style.display = 'none';
            });
    }

    // Highlight matches in text
    function highlightTerms(text, terms) {
        if (!text || !terms || terms.length === 0) return escapeHtml(text || '');
        var escapedTerms = terms.map(function (t) {
            return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }).filter(Boolean);
        if (escapedTerms.length === 0) return escapeHtml(text);

        var regex = new RegExp('(' + escapedTerms.join('|') + ')', 'gi');
        var parts = text.split(regex);
        return parts.map(function (part) {
            if (regex.test(part)) {
                return '<mark class="search-highlight">' + escapeHtml(part) + '</mark>';
            }
            return escapeHtml(part);
        }).join('');
    }

    function escapeHtml(str) {
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // Extract relevant snippet around matched terms
    function extractExcerpt(summary, terms, maxLen) {
        if (!summary) return '';
        maxLen = maxLen || 140;
        if (summary.length <= maxLen) return summary;

        var lower = summary.toLowerCase();
        var firstIdx = -1;
        for (var i = 0; i < terms.length; i++) {
            var idx = lower.indexOf(terms[i]);
            if (idx !== -1 && (firstIdx === -1 || idx < firstIdx)) {
                firstIdx = idx;
            }
        }

        if (firstIdx === -1) {
            return summary.substring(0, maxLen).trim() + '...';
        }

        var start = Math.max(0, firstIdx - 40);
        var end = Math.min(summary.length, start + maxLen);
        var snippet = summary.substring(start, end).trim();
        if (start > 0) snippet = '...' + snippet;
        if (end < summary.length) snippet = snippet + '...';
        return snippet;
    }

    // Perform query matching and ranking
    function executeSearch(query) {
        query = (query || '').trim().toLowerCase();
        if (!query) {
            currentResults = [];
            selectedIndex = -1;
            if (resultsContainer) resultsContainer.style.display = 'none';
            if (emptyContainer) emptyContainer.style.display = 'none';
            if (initialContainer) initialContainer.style.display = 'block';
            if (statsContainer) statsContainer.textContent = '';
            if (clearBtn) clearBtn.style.display = 'none';
            return;
        }

        if (clearBtn) clearBtn.style.display = 'inline-flex';
        if (initialContainer) initialContainer.style.display = 'none';

        var terms = query.split(/\s+/).filter(Boolean);
        if (terms.length === 0) return;

        var scoredResults = [];
        for (var i = 0; i < searchData.length; i++) {
            var item = searchData[i];
            var titleLower = item.title.toLowerCase();
            var summaryLower = item.summary.toLowerCase();
            var hrefLower = item.rawHref.toLowerCase();

            var allMatch = true;
            var score = 0;

            for (var t = 0; t < terms.length; t++) {
                var term = terms[t];
                var inTitle = titleLower.indexOf(term);
                var inHref = hrefLower.indexOf(term);
                var inSummary = summaryLower.indexOf(term);

                if (inTitle === -1 && inHref === -1 && inSummary === -1) {
                    allMatch = false;
                    break;
                }

                if (inTitle !== -1) {
                    score += 50;
                    if (inTitle === 0) score += 25; // Prefix match bonus
                }
                if (inHref !== -1) score += 20;
                if (inSummary !== -1) score += 10;
            }

            if (allMatch) {
                scoredResults.push({
                    item: item,
                    score: score
                });
            }
        }

        scoredResults.sort(function (a, b) {
            return b.score - a.score;
        });

        currentResults = scoredResults.slice(0, 30).map(function (sr) { return sr.item; });
        renderResults(currentResults, terms);
    }

    // Render results in the palette listbox
    function renderResults(results, terms) {
        if (!resultsContainer) return;

        if (results.length === 0) {
            resultsContainer.style.display = 'none';
            resultsContainer.innerHTML = '';
            if (emptyContainer) emptyContainer.style.display = 'block';
            if (statsContainer) statsContainer.textContent = '0 results';
            return;
        }

        if (emptyContainer) emptyContainer.style.display = 'none';
        resultsContainer.style.display = 'flex';
        selectedIndex = 0; // Default highlight first result

        var html = '';
        for (var i = 0; i < results.length; i++) {
            var res = results[i];
            var titleHtml = highlightTerms(res.title, terms);
            var excerpt = extractExcerpt(res.summary, terms, 130);
            var excerptHtml = highlightTerms(excerpt, terms);

            var isSelected = (i === 0) ? ' is-selected' : '';
            html += '<a href="' + escapeHtml(res.href) + '" class="search-palette-result-item' + isSelected + '" data-index="' + i + '" role="option" aria-selected="' + (i === 0) + '">';
            html += '  <div class="search-result-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></div>';
            html += '  <div class="search-result-content">';
            html += '    <div class="search-result-title">' + titleHtml + '</div>';
            if (excerptHtml) {
                html += '    <div class="search-result-excerpt">' + excerptHtml + '</div>';
            }
            html += '  </div>';
            html += '  <div class="search-result-enter-hint" title="' + escapeHtml('{{#__global.searchShortcutSelect}}{{.}}{{/__global.searchShortcutSelect}}{{^__global.searchShortcutSelect}}Open selected article (Enter){{/__global.searchShortcutSelect}}') + '" aria-label="' + escapeHtml('{{#__global.searchShortcutSelect}}{{.}}{{/__global.searchShortcutSelect}}{{^__global.searchShortcutSelect}}Open selected article (Enter){{/__global.searchShortcutSelect}}') + '"><kbd>↵</kbd></div>';
            html += '</a>';
        }

        resultsContainer.innerHTML = html;
        if (statsContainer) {
            statsContainer.textContent = results.length + ' ' + (results.length === 1 ? 'result' : 'results');
        }

        // Attach mouse hover tracking
        var items = resultsContainer.querySelectorAll('.search-palette-result-item');
        items.forEach(function (el, idx) {
            el.addEventListener('mouseenter', function () {
                updateSelectedIndex(idx, false);
            });
        });
    }

    function updateSelectedIndex(newIndex, scrollIntoView) {
        var items = resultsContainer ? resultsContainer.querySelectorAll('.search-palette-result-item') : [];
        if (items.length === 0) return;

        if (selectedIndex >= 0 && selectedIndex < items.length) {
            items[selectedIndex].classList.remove('is-selected');
            items[selectedIndex].setAttribute('aria-selected', 'false');
        }

        selectedIndex = Math.max(0, Math.min(newIndex, items.length - 1));
        var current = items[selectedIndex];
        if (current) {
            current.classList.add('is-selected');
            current.setAttribute('aria-selected', 'true');
            if (scrollIntoView) {
                current.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
        }
    }

    // SpeechRecognition Voice Search Management
    function stopVoiceListening() {
        isListening = false;
        if (voiceBtn) voiceBtn.classList.remove('is-listening');
        if (navVoiceBtns && navVoiceBtns.length > 0) {
            navVoiceBtns.forEach(function (b) { b.classList.remove('is-listening'); });
        }
        if (input) {
            input.setAttribute('placeholder', 'Search posts, topics, keywords...');
        }
    }

    function initRecognition() {
        if (!SpeechRecognition) return;
        try {
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = true;
            recognition.lang = (document.documentElement && document.documentElement.lang) || 'en-US';

            recognition.onstart = function () {
                isListening = true;
                if (voiceBtn) voiceBtn.classList.add('is-listening');
                if (navVoiceBtns && navVoiceBtns.length > 0) {
                    navVoiceBtns.forEach(function (b) { b.classList.add('is-listening'); });
                }
                if (input) {
                    input.setAttribute('placeholder', voiceListeningText);
                }
            };

            recognition.onresult = function (event) {
                var transcript = '';
                for (var i = event.resultIndex; i < event.results.length; ++i) {
                    transcript += event.results[i][0].transcript;
                }
                if (transcript && input) {
                    input.value = transcript;
                    if (clearBtn) clearBtn.style.display = 'inline-flex';
                    loadSearchIndex(function () {
                        executeSearch(transcript);
                    });
                }
            };

            recognition.onerror = function (event) {
                console.warn('SpeechRecognition error:', event.error);
                stopVoiceListening();
            };

            recognition.onend = function () {
                stopVoiceListening();
            };
        } catch (e) {
            console.warn('SpeechRecognition init failed:', e);
        }
    }

    function startVoiceListening() {
        if (!SpeechRecognition) return;
        if (!recognition) {
            initRecognition();
        }
        if (!recognition) return;
        try {
            recognition.start();
        } catch (e) {
            try {
                recognition.stop();
                setTimeout(function () {
                    try { recognition.start(); } catch (err) {}
                }, 150);
            } catch (err) {}
        }
    }

    if (SpeechRecognition) {
        document.documentElement.classList.add('speech-supported');

        if (voiceBtn) {
            voiceBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (isListening) {
                    if (recognition) {
                        try { recognition.stop(); } catch (err) {}
                    }
                    stopVoiceListening();
                } else {
                    startVoiceListening();
                }
            });
        }
    }

    // Modal open/close controls
    window.openSearchPalette = function (options) {
        if (!modal) return;
        var autoVoice = options && options.autoStartVoice;
        loadSearchIndex(function () {
            if (input && input.value) {
                executeSearch(input.value);
            }
        });
        if (typeof modal.showModal === 'function') {
            modal.showModal();
        } else {
            modal.setAttribute('open', '');
        }
        if (input) {
            setTimeout(function () { input.focus(); input.select(); }, 50);
        }
        if (autoVoice && SpeechRecognition) {
            setTimeout(startVoiceListening, 200);
        }
    };

    window.closeSearchPalette = function () {
        if (!modal) return;
        if (recognition && isListening) {
            try { recognition.stop(); } catch (err) {}
            stopVoiceListening();
        }
        if (typeof modal.close === 'function') {
            modal.close();
        } else {
            modal.removeAttribute('open');
        }
    };

    if (closeBtn) {
        closeBtn.addEventListener('click', function () {
            window.closeSearchPalette();
        });
    }

    // Light dismiss on backdrop click
    modal.addEventListener('click', function (e) {
        if (e.target === modal) {
            var rect = modal.getBoundingClientRect();
            var isInDialog = (
                rect.top <= e.clientY &&
                e.clientY <= rect.top + rect.height &&
                rect.left <= e.clientX &&
                e.clientX <= rect.left + rect.width
            );
            if (!isInDialog) {
                window.closeSearchPalette();
            }
        }
    });

    if (input) {
        input.addEventListener('input', function () {
            loadSearchIndex(function () {
                executeSearch(input.value);
            });
        });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                updateSelectedIndex(selectedIndex + 1, true);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                updateSelectedIndex(selectedIndex - 1, true);
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (currentResults && currentResults[selectedIndex]) {
                    window.location.href = currentResults[selectedIndex].href;
                }
            } else if (e.key === 'Escape') {
                window.closeSearchPalette();
            }
        });
    }

    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            if (input) {
                input.value = '';
                input.focus();
                executeSearch('');
            }
        });
    }

    // Hotkey match checker
    function matchesConfiguredHotkey(e, hotkeyStr) {
        if (!hotkeyStr) return false;
        var parts = hotkeyStr.toLowerCase().split('+').map(function (p) { return p.trim(); });
        var needsCtrl = parts.indexOf('ctrl') !== -1;
        var needsCmd = parts.indexOf('cmd') !== -1 || parts.indexOf('meta') !== -1;
        var needsShift = parts.indexOf('shift') !== -1;
        var needsAlt = parts.indexOf('alt') !== -1;

        // Primary key is the last token or single character
        var keyToken = parts[parts.length - 1];

        var hasMod = needsCtrl || needsCmd;
        var actualMod = e.ctrlKey || e.metaKey;

        if (hasMod) {
            if (!actualMod) return false;
            if (e.key.toLowerCase() === keyToken) return true;
            if (e.code && e.code.toLowerCase() === 'key' + keyToken) return true;
        } else {
            // Single character shortcut like '/' or '?'
            if (!e.ctrlKey && !e.metaKey && !e.altKey && (e.key === keyToken || e.key === hotkeyStr)) {
                return true;
            }
        }
        return false;
    }

    // Global keyboard shortcut listener
    window.addEventListener('keydown', function (e) {
        // Check for search / voice shortcuts
        var isTargetInput = e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable);
        var isSearchHotkey = matchesConfiguredHotkey(e, configuredHotkey) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k');
        var isVoiceHotkey = matchesConfiguredHotkey(e, configuredVoiceHotkey) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'm');

        if (isVoiceHotkey && SpeechRecognition) {
            e.preventDefault();
            if (!modal.open) {
                window.openSearchPalette({ autoStartVoice: true });
            } else {
                if (isListening) {
                    if (recognition) {
                        try { recognition.stop(); } catch (err) {}
                    }
                    stopVoiceListening();
                } else {
                    startVoiceListening();
                }
            }
            return;
        }

        if (!isTargetInput) {
            if (e.key === '/' || isSearchHotkey) {
                e.preventDefault();
                window.openSearchPalette();
                return;
            }
        } else if (modal.open && e.target === input) {
            // Inside search input
            if (e.key === 'Escape') {
                e.preventDefault();
                window.closeSearchPalette();
            }
        } else if (isSearchHotkey) {
            e.preventDefault();
            window.openSearchPalette();
        }
    });

    // Wire WebMCP Search Blog Tool if present
    if (typeof document !== 'undefined' && 'modelContext' in document && document.modelContext && document.modelContext.registerTool) {
        try {
            document.modelContext.registerTool({
                name: 'search_blog',
                description: 'Search articles and blog posts by keywords',
                inputSchema: {
                    type: 'object',
                    properties: {
                        query: { type: 'string', description: 'Search term or keyword' }
                    },
                    required: ['query']
                },
                execute: async function (args) {
                    var q = args && args.query ? args.query : '';
                    window.openSearchPalette();
                    if (input) {
                        input.value = q;
                        loadSearchIndex(function () {
                            executeSearch(q);
                        });
                    }
                    return { content: [{ type: 'text', text: 'Search palette opened with query: ' + q }] };
                },
                annotations: { readOnlyHint: true }
            });
        } catch (e) {}
    }
})();
</script>
{{/_enableSearch}}
