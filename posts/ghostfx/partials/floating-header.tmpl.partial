<div class="floating-header">
    <div class="floating-header-logo">
        <a href="{{#_appUrl}}{{_appUrl}}{{/_appUrl}}{{^_appUrl}}{{_rel}}{{/_appUrl}}">
            {{#_appFaviconPath}}
                <img src="{{_rel}}{{.}}" alt="{{_appTitle}} icon" width="20" height="20" />
            {{/_appFaviconPath}}
            <span>{{_appTitle}}</span>
        </a>
        <span class="floating-header-divider">&mdash;</span>
    </div>
    <div class="floating-header-title">{{#title}}{{title}}{{/title}}{{^title}}{{_appTitle}}{{/title}}</div>
    <div class="floating-header-share">
        <!-- Social Media Sharing Dropdown Group -->
        <div class="floating-header-social-group">
            <button type="button" class="floating-header-share-label" aria-haspopup="true" aria-expanded="false" aria-label="Share this" title="Share this">
                <span class="share-desktop-text">Share this</span>
                <span class="share-desktop-icon">{{>partials/icons/point}}</span>
                <span class="share-mobile-icon">{{>partials/icons/share}}</span>
            </button>
            <div class="floating-header-social-list" role="menu">
                <a class="floating-header-share-item floating-header-share-x" href="https://x.com/intent/post?text={{encode title}}&amp;url={{_rel}}{{uid}}.html"
                    target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, 'share-x', 'width=550,height=450');return false;" title="Share on X" role="menuitem">
                    {{>partials/icons/x}}
                    <span class="social-text">X / Twitter</span>
                </a>
                <a class="floating-header-share-item floating-header-share-fb" href="https://www.facebook.com/sharer/sharer.php?u={{_rel}}{{uid}}.html"
                    target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, 'share-facebook','width=580,height=400');return false;" title="Share on Facebook" role="menuitem">
                    {{>partials/icons/facebook}}
                    <span class="social-text">Facebook</span>
                </a>
                <a class="floating-header-share-item floating-header-share-bsky" href="https://bsky.app/intent/compose?text={{encode title}}%20{{_rel}}{{uid}}.html"
                    target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, 'share-bluesky','width=580,height=420');return false;" title="Share on BlueSky" role="menuitem">
                    {{>partials/icons/bluesky}}
                    <span class="social-text">BlueSky</span>
                </a>
                <a class="floating-header-share-item floating-header-share-masto" href="https://mastodon.social/share?text={{encode title}}%20{{_rel}}{{uid}}.html"
                    target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, 'share-mastodon','width=600,height=600');return false;" title="Share on Mastodon" role="menuitem">
                    {{>partials/icons/mastodon}}
                    <span class="social-text">Mastodon</span>
                </a>
                <a class="floating-header-share-item floating-header-share-li" href="https://www.linkedin.com/feed/?shareActive=true&amp;text={{encode title}}%20{{_rel}}{{uid}}.html"
                    target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, 'share-linkedin','width=650,height=650');return false;" title="Share on LinkedIn" role="menuitem">
                    {{>partials/icons/linkedin}}
                    <span class="social-text">LinkedIn</span>
                </a>
                <a class="floating-header-share-item floating-header-share-re" href="https://reddit.com/submit?url={{_rel}}{{uid}}.html&title={{encode title}}"
                    target="_blank" rel="noopener noreferrer" onclick="window.open(this.href, 'share-reddit','width=580,height=500');return false;" title="Share on Reddit" role="menuitem">
                    {{>partials/icons/reddit}}
                    <span class="social-text">Reddit</span>
                </a>
                <a class="floating-header-share-item floating-header-share-email" href="mailto:?subject={{encode title}}&body=Check out this site: {{_rel}}{{uid}}.html" title="Share via Email" role="menuitem">
                    {{>partials/icons/email}}
                    <span class="social-text">Email</span>
                </a>
            </div>
        </div>

        <!-- QR Code / Share Button -->
        <button type="button" class="floating-header-share-btn floating-qr-code" data-title="{{#title}}{{title}}{{/title}}{{^title}}{{_appTitle}}{{/title}}" title="QR Code &amp; Share" aria-label="QR Code and Share">
            {{>partials/icons/qr}}
        </button>

        {{^_disableMarkdown}}
        <button type="button" class="floating-header-share-btn floating-copy-markdown" data-uid="{{uid}}" data-slug="{{uid}}" title="Copy Markdown source" aria-label="Copy Markdown source">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
        </button>
        {{/_disableMarkdown}}

        {{#_enableSearch}}
        <!-- Search Button -->
        <button type="button" class="floating-header-search-btn" onclick="window.openSearchPalette && window.openSearchPalette();return false;" title="{{#_searchHotkey}}Search posts ({{.}}){{/_searchHotkey}}{{^_searchHotkey}}{{#__global.searchTitle}}{{.}}{{/__global.searchTitle}}{{^__global.searchTitle}}Search posts (Ctrl+K){{/__global.searchTitle}}{{/_searchHotkey}}" aria-label="{{#_searchHotkey}}Search posts ({{.}}){{/_searchHotkey}}{{^_searchHotkey}}{{#__global.searchAriaLabel}}{{.}}{{/__global.searchAriaLabel}}{{^__global.searchAriaLabel}}Search posts (Ctrl+K){{/__global.searchAriaLabel}}{{/_searchHotkey}}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </button>
        {{/_enableSearch}}
    </div>
    <progress id="reading-progress" class="progress" value="0">
        <div class="progress-container">
            <span class="progress-bar"></span>
        </div>
    </progress>
</div>

<script>
(function () {
    function initFloatingHeader() {
        var header = document.querySelector('.floating-header');
        if (!header) return;

        var progressBar = document.querySelector('#reading-progress');
        var title = document.querySelector('.post-full-title') || document.querySelector('.site-title') || document.querySelector('h1');

        try {
            var appUrl = '{{#_appUrl}}{{_appUrl}}{{/_appUrl}}{{^_appUrl}}https://jochen.kirstaetter.name{{/_appUrl}}'.replace(/\/+$/, '');
            var canonicalLink = document.querySelector('link[rel="canonical"]');
            var rawUrl = canonicalLink ? (canonicalLink.getAttribute('href') || canonicalLink.href) : '';
            if (!rawUrl) {
                rawUrl = appUrl + window.location.pathname;
            }
            if (rawUrl.startsWith('/')) {
                rawUrl = appUrl + rawUrl;
            }
            rawUrl = rawUrl.split('?')[0].split('#')[0];
            try {
                var parsed = new URL(rawUrl, appUrl);
                if (parsed.hostname === 'localhost' || parsed.hostname === '127.0.0.1' || parsed.hostname.endsWith('.localhost')) {
                    rawUrl = appUrl + parsed.pathname;
                }
            } catch (e) {}
            rawUrl = rawUrl.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
            if (rawUrl.length > appUrl.length + 1 && rawUrl.endsWith('/')) {
                rawUrl = rawUrl.slice(0, -1);
            }

            var currentUrl = encodeURIComponent(rawUrl);
            var currentTitle = encodeURIComponent(document.title || (title ? title.innerText : ''));

            var x = header.querySelector('.floating-header-share-x, .floating-header-share-tw');
            if (x) x.href = 'https://x.com/intent/post?text=' + currentTitle + '&url=' + currentUrl;

            var fb = header.querySelector('.floating-header-share-fb');
            if (fb) fb.href = 'https://www.facebook.com/sharer/sharer.php?u=' + currentUrl;

            var bsky = header.querySelector('.floating-header-share-bsky');
            if (bsky) bsky.href = 'https://bsky.app/intent/compose?text=' + currentTitle + '%20' + currentUrl;

            var masto = header.querySelector('.floating-header-share-masto');
            if (masto) masto.href = 'https://mastodon.social/share?text=' + currentTitle + '%20' + currentUrl;

            var li = header.querySelector('.floating-header-share-li');
            if (li) li.href = 'https://www.linkedin.com/feed/?shareActive=true&text=' + currentTitle + '%20' + currentUrl;

            var re = header.querySelector('.floating-header-share-re');
            if (re) re.href = 'https://reddit.com/submit?url=' + currentUrl + '&title=' + currentTitle;

            var em = header.querySelector('.floating-header-share-email');
            if (em) em.href = 'mailto:?subject=' + currentTitle + '&body=Check out this site: ' + currentUrl;
        } catch (e) {}

        // Mobile / Tablet Web Share API with fallback to dropdown list
        var socialGroup = header.querySelector('.floating-header-social-group');
        var labelToggle = header.querySelector('.floating-header-share-label');
        if (socialGroup && labelToggle) {
            function toggleDropdown() {
                var isOpen = socialGroup.classList.contains('is-open');
                if (isOpen) {
                    socialGroup.classList.remove('is-open');
                    labelToggle.setAttribute('aria-expanded', 'false');
                } else {
                    socialGroup.classList.add('is-open');
                    labelToggle.setAttribute('aria-expanded', 'true');
                }
            }

            labelToggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var isMobileOrTablet = window.matchMedia('(max-width: 768px)').matches;

                // Probe for Web Share API on mobile/tablet viewports
                if (isMobileOrTablet && navigator.share) {
                    var shareUrl = (typeof rawUrl !== 'undefined' && rawUrl) ? rawUrl : (appUrl + window.location.pathname).split('?')[0].split('#')[0].replace(/\/index\.html$/, '/').replace(/\.html$/, '');
                    var shareTitle = document.title || (title ? title.innerText : '');
                    var shareData = {
                        title: shareTitle,
                        text: shareTitle,
                        url: shareUrl
                    };

                    if (!navigator.canShare || navigator.canShare(shareData)) {
                        navigator.share(shareData).catch(function (err) {
                            if (err.name !== 'AbortError') {
                                // Fallback to dropdown list on sharing error
                                toggleDropdown();
                            }
                        });
                        return;
                    }
                }

                // Default fallback: toggle dropdown list
                toggleDropdown();
            });

            document.addEventListener('click', function (e) {
                if (!socialGroup.contains(e.target)) {
                    socialGroup.classList.remove('is-open');
                    labelToggle.setAttribute('aria-expanded', 'false');
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && socialGroup.classList.contains('is-open')) {
                    socialGroup.classList.remove('is-open');
                    labelToggle.setAttribute('aria-expanded', 'false');
                }
            });
        }

        var ticking = false;

        function update() {
            var lastScrollY = window.scrollY || window.pageYOffset;
            var lastWindowHeight = window.innerHeight;
            var lastDocumentHeight = Math.max(
                document.body.scrollHeight, document.documentElement.scrollHeight,
                document.body.offsetHeight, document.documentElement.offsetHeight
            );

            var trigger = 150;
            if (title) {
                var rect = title.getBoundingClientRect();
                trigger = rect.top + lastScrollY + (title.offsetHeight || 40);
            }
            var progressMax = lastDocumentHeight - lastWindowHeight;

            if (lastScrollY >= trigger) {
                header.classList.add('floating-active');
            } else {
                header.classList.remove('floating-active');
                if (socialGroup) {
                    socialGroup.classList.remove('is-open');
                    if (labelToggle) labelToggle.setAttribute('aria-expanded', 'false');
                }
            }

            if (progressBar && progressMax > 0) {
                progressBar.setAttribute('max', progressMax);
                progressBar.setAttribute('value', lastScrollY);
            }

            ticking = false;
        }

        function requestTick() {
            if (!ticking) {
                requestAnimationFrame(update);
            }
            ticking = true;
        }

        window.addEventListener('scroll', requestTick, { passive: true });
        window.addEventListener('resize', requestTick, false);

        update();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFloatingHeader);
    } else {
        initFloatingHeader();
    }
})();
</script>