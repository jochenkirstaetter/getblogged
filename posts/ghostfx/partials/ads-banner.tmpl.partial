{{#_googleAdSenseClientId}}
{{#_googleAdSenseSlotId}}
<section class="ads-banner" style="display:flex;justify-content:center;align-items:center;min-height:280px;contain-intrinsic-size:1000px 280px;content-visibility:auto;overflow:hidden;">
<!-- Responsive - Tech -->
<ins class="adsbygoogle"
     style="display:block;min-height:250px;width:100%;"
     data-ad-client="{{_googleAdSenseClientId}}"
     data-ad-slot="{{_googleAdSenseSlotId}}"
     data-ad-format="auto"
     data-full-width-responsive="true"></ins>
<script>
if (typeof window !== 'undefined' && window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
    (window.adsbygoogle = window.adsbygoogle || []).push({});
}
</script>
</section>
{{/_googleAdSenseSlotId}}
{{/_googleAdSenseClientId}}

