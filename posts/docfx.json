{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "**.md"
        ],
        "src": "published",
        "dest": ""
      },
      {
        "files": [
          "**.md"
        ],
        "src": "pages",
        "dest": ""
      },
      {
        "files": [
          "**.md",
          "**/toc.yml"
        ],
        "exclude": [
          "index-draft.md",
          "draft/**",
          "published/**",
          "pages/**",
          "ghostfx/**",
          "_site/**",
          "**/_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/content/images/**",
          "files/**",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.svg",
          "*.ico",
          "site.webmanifest",
          "*.txt",
          "*.xml",
          "*.html"
        ],
        "exclude": [
          "**/content/images/size/**",
          "files/*.exe",
          "ghostfx/**",
          "_site/**",
          "**/_site/**"
        ]
      }
    ],
    "output": "_site",
    "markdownEngineProperties": {
      "markdigExtensions": [
        "customcontainers",
        "diagrams",
        "emphasisextras",
        "abbreviations",
        "medialinks",
        "autolinks",
        "yaml",
        "emojis"
      ],
      "alerts": {
        "GRID": "grid alert-grid",
        "STRIP": "strip alert-strip",
        "GALLERY": "gallery alert-gallery"
      }
    },
    "postProcessors": [],
    "template": [
      "default",
      "modern",
      "ghostfx"
    ],
    "globalMetadata": {
      "_lang": "en",
      "_appUrl": "https://jochen.kirstaetter.name",
      "_appTitle": "Get Blogged by JoKi",
      "_appName": "Get Blogged by JoKi",
      "_appFaviconPath": "favicon.png",
      "_appFooter": "<span>Generated by <a href='https://github.com/jochenkirstaetter/ghostfx'>GhostFx</a> for DocFx</span>",
      "_enableSearch": true,
      "_searchHotkey": "Ctrl+K",
      "_voiceHotkey": "Ctrl+M",
      "_disableMarkdown": false,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/jochenkirstaetter/getblogged",
        "branch": "main"
      },
      "_disableBreadcrumb": true,
      "_disableNextArticle": true,
      "_googleAnalyticsTagId": "G-F1KD1511QR",
      "_googleAdSenseClientId": "ca-pub-6955756848063025",
      "_googleAdSenseSlotId": "4896696906",
      "_disqusSiteId": "getbloggedbyjoki",
      "_siteTwitter": "@jkirstaetter",
      "_siteFacebook": "https://facebook.com/jochen.kirstaetter",
      "_indexCount": 12,
      "_currentYear": 2026,
      "_galleryFlexible": true,
      "_assetVersion": "v68-22835c0"
    },
    "sitemap": {
      "baseUrl": "https://jochen.kirstaetter.name/",
      "priority": 0.9,
      "changefreq": "weekly"
    }
  }
}
