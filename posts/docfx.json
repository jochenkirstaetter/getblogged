{
  "build": {
    "content": [
      {
        "files": [
          "**.md"
        ],
        "src": "published",
        "dest": ""
      },
      {
        "files": [
          "**.md"
        ],
        "src": "pages",
        "dest": ""
      },
      {
        "files": [
          "**.md",
          "**/toc.yml"
        ],
        "exclude": [
          "draft/**",
          "published/**",
          "pages/**",
          "ghostfx/**",
          "_site/**",
          "**/_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/content/images/**",
          "files/**",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.svg",
          "*.ico",
          "site.webmanifest",
          "ads.txt",
          "robots.txt",
          "llms.txt",
          "*.xml",
          "*.html"
        ],
        "exclude": [
          "files/*.exe",
          "ghostfx/**",
          "_site/**",
          "**/_site/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "ghostfx"
    ],
    "globalMetadata": {
      "_lang": "en",
      "_appUrl": "https://jochen.kirstaetter.name",
      "_appTitle": "Get Blogged by JoKi",
      "_appName": "Get Blogged by JoKi",
      "_appFaviconPath": "favicon.png",
      "_appFooter": "\u003Cspan\u003EGenerated by \u003Ca href=\u0027https://github.com/jochenkirstaetter/ghostfx\u0027\u003EGhostFx\u003C/a\u003E for DocFx\u003C/span\u003E",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/jochenkirstaetter/getblogged",
        "branch": "main"
      },
      "_disableBreadcrumb": true,
      "_disableNextArticle": true,
      "_googleAnalyticsTagId": "G-F1KD1511QR",
      "_googleAdSenseClientId": "ca-pub-6955756848063025",
      "_googleAdSenseSlotId": "4896696906",
      "_disqusSiteId": "getbloggedbyjoki",
      "_siteTwitter": "@jkirstaetter",
      "_siteFacebook": "https://facebook.com/jochen.kirstaetter",
      "_currentYear": 2026
    }
  }
}