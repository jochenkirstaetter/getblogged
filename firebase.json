{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "hosting": {
    "public": "posts/_site",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sw-v1.js",
        "destination": "/public/sw-v1.js"
      },
      {
        "source": "/error404",
        "destination": "/404.html"
      },
      {
        "source": "/error404.html",
        "destination": "/404.html"
      },
      {
        "source": "/.well-known/llms.txt",
        "destination": "/llms.txt"
      },
      {
        "source": "/rss",
        "destination": "/sitemap.xml"
      },
      {
        "source": "/atom",
        "destination": "/sitemap.xml"
      },
      {
        "source": "/.well-known/security.txt",
        "destination": "/security.txt"
      }
    ],
    "redirects": [
      {
        "source": "/tag/:path*",
        "destination": "/tags/:path*",
        "type": 301
      },
      {
        "source": "/assets/:path*",
        "destination": "/public/:path*",
        "type": 301
      },
      {
        "source": "/images/:path*",
        "destination": "/content/images/:path*",
        "type": 301
      },
      {
        "source": "/ghost/",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "@(sw-v1.js|public/sw-v1.js|sw.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|avif|woff|woff2|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          }
        ]
      },
      {
        "source": "**/*.@(md|markdown)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          }
        ]
      },
      {
        "source": "raw/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          }
        ]
      },
      {
        "source": "@(robots.txt|ads.txt|security.txt)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "@(llms.txt|llms-full.txt|.well-known/llms.txt)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}