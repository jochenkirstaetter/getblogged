{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "hosting": {
    "public": "posts/_site",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sw-v1.js",
        "destination": "/public/sw-v1.js"
      },
      {
        "source": "/404",
        "destination": "/error404.html"
      },
      {
        "source": "/404.html",
        "destination": "/error404.html"
      },
      {
        "source": "/rss",
        "destination": "/sitemap.xml"
      },
      {
        "source": "/atom",
        "destination": "/sitemap.xml"
      }
    ],
    "redirects": [
      {
        "source": "/assets/:path*",
        "destination": "/public/:path*",
        "type": 301
      },
      {
        "source": "/images/:path*",
        "destination": "/content/images/:path*",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "@(sw-v1.js|public/sw-v1.js|sw.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|avif|woff|woff2|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}